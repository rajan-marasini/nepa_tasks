    "drizzle-kit": "^1.0.0-rc.4",
    "tsx": "^4.23.15"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "drizzle-orm": "^1.0.0-rc.4",
    "express": "^5.2.1",
    "pg": "^8.23.1",
    "winston": "^3.19.0"
  }
}
